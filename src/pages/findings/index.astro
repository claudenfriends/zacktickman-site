---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const findings = (await getCollection('findings')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
---
<Base title="Findings — Zack Tickman" description="Original security research. Repro steps, vendor correspondence, disclosure timelines.">
  <div class="wrap">
    <h1 class="lede">Findings</h1>
    <p class="intro" style="margin-bottom:3rem;">
      Original research, published after coordinated disclosure. Each writeup carries repro steps,
      the vendor's response in its own words, and a dated timeline.
    </p>
    <h2 class="section-label">All findings</h2>
    {findings.map((f) => (
      <a class="entry" href={`/findings/${f.id}/`}>
        <span class="entry-line">
          <span class:list={['dot', f.data.status === 'fixed' ? 'dot--settled' : 'dot--live']}></span>
          {f.data.number} · {f.data.vendor} · {f.data.statusNote}
        </span>
        <h3 class="entry-title">{f.data.title}</h3>
        <p class="entry-dek">{f.data.dek}</p>
      </a>
    ))}
  </div>
</Base>
