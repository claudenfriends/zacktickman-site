---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const findings = await getCollection('findings');
  return findings.map((f) => ({ params: { slug: f.id }, props: { f } }));
}

const { f } = Astro.props;
const { Content } = await render(f);
const d = f.data;
const fmt = (dt) => dt.toISOString().slice(0, 10);
---
<Base title={`${d.title} — Zack Tickman`} description={d.dek}>
  <article class="wrap" style="padding-top:3.5rem;">
    <p class="eyebrow">Finding {d.number} · {d.vendor}</p>
    <h1 class="finding-title">{d.title}</h1>
    <p class="dek">{d.dek}</p>

    <dl class="meta">
      <div class="status">
        <span class:list={['dot', d.status === 'fixed' ? 'dot--settled' : 'dot--live']}></span>
        <dd>{d.statusNote}</dd>
      </div>
      <dd>{d.affected}</dd>
      <dd>{fmt(d.published)}</dd>
      {d.reports.length > 0 && <dd>{d.reports.join(' · ')}</dd>}
    </dl>

    <blockquote class="statement">
      <p>“Locked and hidden apps are intended to help offer users peace of mind that information they want to keep private, such as app notifications and content, will not inadvertently be seen by others. It is not intended to remove all traces of an app from the system. After reviewing your report, we've determined that this scenario is beyond the current protections provided by locked and hidden apps.”</p>
      <cite>Apple Product Security — returned verbatim to all three reports, 6 May 2026</cite>
    </blockquote>

    <div class="prose"><Content /></div>

    {d.timeline.length > 0 && (
      <section class="timeline">
        <h2>Disclosure timeline</h2>
        <ol>
          {d.timeline.map((t) => (
            <li>
              <span class:list={['dot', t.resolved ? 'dot--settled' : 'dot--live']}></span>
              <time datetime={t.date}>{t.date}</time>
              <span class="event">{t.event}</span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</Base>
